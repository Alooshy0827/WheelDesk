{
  "name": "wheeldesk",
  "productName": "WheelDesk",
  "version": "0.1.3",
  "private": true,
  "description": "Configurable desktop action wheels and AI workflows",
  "author": "WheelDesk contributors; based on lolPing by Danrui Meng",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:helper": "node native/hook-helper/run.mjs build",
    "test:helper": "node native/hook-helper/run.mjs test",
    "dist": "npm run build:helper && electron-vite build && electron-builder --win --publish never",
    "dist:mac": "npm run build:helper && electron-vite build && electron-builder --mac --arm64 --publish never",
    "dist:win": "npm run build:helper && electron-vite build && electron-builder --win --publish never",
    "smoke": "electron tools/smoke.cjs"
  },
  "devDependencies": {
    "@fluentui/react-components": "9.74.9",
    "@fluentui/react-icons": "2.0.343",
    "@fluentui/react-motion-components-preview": "0.15.9",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@noble/secp256k1": "3.2.0",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "dompurify": "3.4.17",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.10",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "jsdom": "29.1.1",
    "marked": "18.1.1",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  },
  "build": {
    "appId": "app.wheeldesk.desktop",
    "productName": "WheelDesk",
    "directories": {
      "output": "release",
      "buildResources": "build/desk"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "extraResources": [],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/desk/icon.ico",
      "extraResources": [
        {
          "from": "native/hook-helper/build/hook-helper.exe",
          "to": "hook-helper.exe"
        },
        {
          "from": "native/hook-helper/build/context-helper.exe",
          "to": "context-helper.exe"
        },
        {
          "from": "build/desk/trayTemplate.png",
          "to": "trayTemplate.png"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "WheelDesk-Setup-${version}.exe"
    },
    "mac": {
      "minimumSystemVersion": "13.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/desk/icon.png",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "extraResources": [
        {
          "from": "native/hook-helper/build/hook-helper",
          "to": "hook-helper"
        },
        {
          "from": "native/hook-helper/build/context-helper",
          "to": "context-helper"
        },
        {
          "from": "build/desk",
          "to": ".",
          "filter": [
            "tray*Template*.png"
          ]
        }
      ],
      "extendInfo": {
        "NSAccessibilityUsageDescription": "WheelDesk uses Accessibility for wheel gestures and configured keyboard actions.",
        "NSScreenCaptureUsageDescription": "WheelDesk captures only regions you select for screenshots and AI requests."
      }
    },
    "dmg": {
      "artifactName": "WheelDesk-${version}-arm64.dmg"
    },
    "publish": null
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Alooshy0827/WheelDesk.git"
  },
  "homepage": "https://github.com/Alooshy0827/WheelDesk"
}
